# 参考项目：不进仓库
/reference/

# 模板构建工作区（node_modules / dist 临时产物）
/.build/

# Flutter / Dart
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
# pubspec.lock **必须入库**：依赖全是 caret 范围，lock 不进仓库等于每次 CI
# 都重新解一套新版本，构建不可复现。tts_service 里还有一处依赖 just_audio
# 内部行为的写法，上游小版本一改就静默失效 —— 更要锁住。
# **/pubspec.lock
app/android/.gradle/
app/android/local.properties
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/.metadata

# IDE
.idea/
.vscode/
*.iml

# 系统
.DS_Store

# AI 助手的本地工作区（会话记忆 / 临时状态）。
# 项目真正要留档的工作日志在 text/worklogs/，那个是入库的 —— 这里只是工具状态。
.workbuddy-ai/
Thumbs.db

# 临时
*.log
*.tmp
core/_selftest.txt

# Python
__pycache__/
*.pyc

# 模板构建源 templates_src：源码入库，node_modules/dist 不进仓库
/templates_src/*/node_modules/
/templates_src/*/dist/
